APP_NAME=SatQuery AI Backend
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=
TEST_DATABASE_URL=

# Where ingested rasters are kept so analysis can re-read them.
# Defaults to backend/storage/rasters.
RASTER_STORAGE_DIR=

# Origins allowed to call the API (JSON list). Defaults to the Vite dev server.
# CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Signs access tokens (HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates every issued session.
SECRET_KEY=
# How long a session lasts. Defaults to 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720
